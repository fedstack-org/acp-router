{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["packages/*/src"],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/adapters/telegram" },
    { "path": "packages/cli" }
  ]
}
